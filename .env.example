# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.

AUTH_SECRET=                        # Required: 32+ char random string — openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000  # Required: change to your production URL when deploying

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: anthropic | gemini | groq | ollama  (default: anthropic)
AI_PROVIDER=anthropic
# AI_MODEL=                         # Optional: override the default model for the chosen provider

# ─── Anthropic (Claude) — paid ───────────────────────────────────────────────
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Google Gemini — FREE tier (15 RPM · 1M tokens/day) ─────────────────────
# Get FREE key: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# ─── Groq — FREE tier (Llama 3.3 70B, very fast) ────────────────────────────
# Get FREE key: https://console.groq.com
GROQ_API_KEY=

# ─── Ollama — self-hosted, no rate limits ────────────────────────────────────
# Run locally: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ─── Paystack (payments) ─────────────────────────────────────────────────────
# Get keys: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=    # pk_test_... or pk_live_...
PAYSTACK_SECRET_KEY=                # sk_test_... or sk_live_...

# ─── Resend (email) — FREE 3,000/month ───────────────────────────────────────
# Get free key: https://resend.com
RESEND_API_KEY=

# ─── Mux (video hosting) — optional ─────────────────────────────────────────
# Use Mux playback IDs as lesson contentUrl values
# Get key: https://dashboard.mux.com
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
